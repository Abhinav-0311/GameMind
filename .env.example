DATABASE_URL=postgresql://postgres:postgres@db:5432/gamemind
ENVIRONMENT=development
AUTH_REQUIRED=false
# Required and unique in production. Never commit the production value.
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Only used by the one-off legacy workspace ownership bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
CHROMA_HOST=chromadb
CHROMA_PORT=8000
LLM_PROVIDER=mock
LOCAL_MODEL_NAME=local-rule-engine
DESIGN_AGENT_PROVIDER=mock
DESIGN_AGENT_FALLBACK_TO_MOCK=true

# Optional hosted design-agent inference. Leave the provider as mock for the
# deterministic zero-cost workflow. Never commit a real API key.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct
NVIDIA_PLAN_MODEL_NAME=
NVIDIA_GENERATE_MODEL_NAME=
NVIDIA_CRITIQUE_MODEL_NAME=
NVIDIA_REVISE_MODEL_NAME=
NVIDIA_PLAN_MAX_TOKENS=1200
NVIDIA_GENERATE_MAX_TOKENS=6000
NVIDIA_CRITIQUE_MAX_TOKENS=2500
NVIDIA_REVISE_MAX_TOKENS=6000
NVIDIA_TIMEOUT_SECONDS=45
NVIDIA_MAX_RETRIES=2
NVIDIA_RETRY_BACKOFF_SECONDS=0.5
NVIDIA_REPAIR_ENABLED=true
# Enable only when the selected NVIDIA model supports OpenAI JSON mode.
NVIDIA_JSON_MODE_ENABLED=false

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
