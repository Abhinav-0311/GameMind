DATABASE_URL=postgresql://postgres:postgres@db:5432/gamemind
ENVIRONMENT=development
AUTH_REQUIRED=false
# Required and unique in production. Never commit the production value.
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Only used by the one-off legacy workspace ownership bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
CHROMA_HOST=chromadb
CHROMA_PORT=8000
LLM_PROVIDER=mock
LOCAL_MODEL_NAME=local-rule-engine

# Optional future hosted provider settings. Leave empty for the zero-cost local demo.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
