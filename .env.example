DATABASE_URL=postgresql://postgres:postgres@db:5432/gamemind
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_RECYCLE_SECONDS=1800
ENVIRONMENT=development
AUTH_REQUIRED=false
# Required and unique in production. Never commit the production value.
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Only used by the one-off legacy workspace ownership bootstrap command.
BOOTSTRAP_ADMIN_EMAIL=
CHROMA_HOST=chromadb
CHROMA_PORT=8000
LLM_PROVIDER=mock
LOCAL_MODEL_NAME=local-rule-engine
DESIGN_AGENT_PROVIDER=
DESIGN_AGENT_FALLBACK_TO_MOCK=true
DESIGN_AGENT_EXECUTION_MODE=inline
DESIGN_AGENT_JOB_POLL_SECONDS=1
DESIGN_AGENT_JOB_LEASE_SECONDS=300
DESIGN_AGENT_JOB_MAX_ATTEMPTS=3

# Optional hosted design-agent inference. Set LLM_PROVIDER=nvidia explicitly.
# One NVIDIA key can route both planner and artifact calls. Add a separate
# artifact key only when your NVIDIA account requires it. Never commit real keys.
NVIDIA_NANO_API_KEY=
NVIDIA_SUPER_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_PLAN_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_PLAN_API_KEY_ENV=NVIDIA_NANO_API_KEY
NVIDIA_PLAN_MAX_TOKENS=1024
NVIDIA_CRITIQUE_MAX_TOKENS=4000
NVIDIA_GENERATE_MAX_TOKENS=8000
NVIDIA_REVISE_MAX_TOKENS=8000
NVIDIA_ARTIFACT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_ARTIFACT_API_KEY_ENV=NVIDIA_NANO_API_KEY
# Required for Super 120B structured JSON: reserve the output budget for the artifact.
NVIDIA_ARTIFACT_DISABLE_THINKING=true
DESIGN_AGENT_EVIDENCE_MAX_ITEMS=10
DESIGN_AGENT_EVIDENCE_MAX_CHARS_PER_ITEM=600
NVIDIA_RETRY_BACKOFF_SECONDS=0.5
NVIDIA_REPAIR_ENABLED=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
