# Copy to .env.production and replace every placeholder before deployment.
ENVIRONMENT=production
AUTH_REQUIRED=true
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_APP_URL=https://app.example.com
EMAIL_DELIVERY_MODE=smtp
EMAIL_FROM_ADDRESS=GameMind <no-reply@example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
BOOTSTRAP_ADMIN_EMAIL=
POSTGRES_USER=gamemind
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=gamemind
DATABASE_URL=postgresql://gamemind:replace-with-a-long-random-password@db:5432/gamemind
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Public browser origin and public API address. Do not include a trailing slash.
CORS_ORIGINS=https://app.example.com
NEXT_PUBLIC_API_URL=https://api.example.com

BACKEND_PORT=8000
FRONTEND_PORT=3000
LLM_PROVIDER=mock
LOCAL_MODEL_NAME=local-rule-engine
