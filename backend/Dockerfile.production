FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# Migrations are intentionally not run here. Production runs them as a
# separate one-off job before application replicas are started.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
